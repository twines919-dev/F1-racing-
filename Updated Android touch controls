
using UnityEngine;

public class MobileInput : MonoBehaviour
{
    public AdvancedCarController car;

    public void LeftDown()
    {
        car.SetSteering(-1f);
    }

    public void RightDown()
    {
        car.SetSteering(1f);
    }

    public void SteeringUp()
    {
        car.SetSteering(0f);
    }

    public void GasDown()
    {
        car.SetThrottle(1f);
    }

    public void GasUp()
    {
        car.SetThrottle(0f);
    }

    public void BrakeDown()
    {
        car.SetBrake(1f);
    }

    public void BrakeUp()
    {
        car.SetBrake(0f);
    }
}
